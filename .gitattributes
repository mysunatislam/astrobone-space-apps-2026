public/mediapipe/* binary
public/models/*.task binary
public/models/*.glb binary
*.wasm binary

# Scientific source hashes and generated Markdown must not vary with core.autocrlf.
*.py text eol=lf
*.md text eol=lf

# Preserve original data bytes (source datasets use both LF and CRLF).
*.csv -text whitespace=cr-at-eol
