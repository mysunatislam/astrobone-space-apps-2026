{
  "name": "astrobone-twin",
  "version": "0.1.0",
  "author": "Mysunat Islam",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:vision": "node scripts/copy-vision-assets.mjs",
    "data:osdr": "python scripts/build_osdr_summary.py",
    "data:mission": "python scripts/build_mission_research.py",
    "data:mission:extended": "python scripts/build_extended_nasa_research.py",
    "data:circulation": "python scripts/build_circulation_reference.py",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/write-sites-worker.mjs",
    "build:github": "vite build --base=/astrobone/",
    "build:android": "npm run prepare:vision && vite build --base=./ --mode android",
    "android:sync": "npm run build:android && npx cap sync android",
    "android:open": "npm run android:sync && npx cap open android",
    "android:run": "npm run android:sync && npx cap run android",
    "android:apk": "npm run android:sync && node scripts/build-android-debug.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test src/*.test.js",
    "test:ui": "node scripts/qa-site.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "@mediapipe/tasks-vision": "^1.0.1",
    "three": "^0.168.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.61.1",
    "vite": "^8.1.4"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.24"
  }
}
